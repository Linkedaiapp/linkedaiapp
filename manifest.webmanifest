{
  "name": "Link Kedai App",
  "short_name": "Link Kedai",
  "description": "Find Link Kedai App home sellers near you and order on WhatsApp.",
  "id": "./?explore",
  "start_url": "./?explore",
  "scope": "./",
  "display": "fullscreen",
  "display_override": [
    "fullscreen",
    "standalone"
  ],
  "background_color": "#F7F5F3",
  "theme_color": "#F7F5F3",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Open or close my shop",
      "short_name": "Open / close",
      "description": "Switch your shop between Open and Closed",
      "url": "./?build&status",
      "icons": [
        {
          "src": "sc-status.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "My store",
      "short_name": "My store",
      "description": "Edit your items, prices and photos",
      "url": "./?build",
      "icons": [
        {
          "src": "sc-store.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Spot It!",
      "short_name": "Spot It!",
      "description": "Find sellers near you on the map",
      "url": "./?explore",
      "icons": [
        {
          "src": "sc-browse.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Affiliate Shops",
      "short_name": "Affiliate",
      "description": "Sellers who share Shopee, TikTok Shop and other shop links",
      "url": "./?explore&affiliate",
      "icons": [
        {
          "src": "sc-affiliate.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}
